# ==================================================================== #
# /link <token>
# ==================================================================== #
async def cmd_link(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    """
    Format: /link <token>
    Cocokkan token dengan users.telegram_link_token, lalu isi telegram_id.
    """
    msg = update.effective_message
    user = update.effective_user
    if not msg or not user:
        return

    args = ctx.args or []
    token = args[0].strip() if args else ""

    if not token:
        await msg.reply_text(
            "⚠️ Format: `/link <token>`\n\n"
            "Contoh:\n`/link 1726987654.abc123def456`\n\n"
            "Token bisa didapat dari web app → *Pengaturan* → *Link Telegram*.",
            parse_mode="Markdown",
        )
        return

    # Validasi format
    if "." not in token:
        await msg.reply_text(
            "❌ Token tidak valid. Format: `<unix_ts>.<random>`",
            parse_mode="Markdown",
        )
        return

    # Cek expiry
    if not is_token_fresh(token):
        await msg.reply_text(
            "❌ Token *kadaluarsa* atau tidak valid.\n\n"
            "Silakan generate ulang dari web app:\n"
            "*Pengaturan → Link Telegram*",
            parse_mode="Markdown",
        )
        return

    # Cari user dengan token ini
    target = find_user_by_link_token(token)
    if not target:
        await msg.reply_text(
            "❌ Token tidak ditemukan.\n"
            "Pastikan Anda copy token terbaru dari web app."
        )
        return

    # Cek: apakah telegram_id ini sudah di-link ke user LAIN?
    already = find_user_by_telegram_id(user.id)
    if already and already["id"] != target["id"]:
        await msg.reply_text(
            f"⚠️ Akun Telegram ini sudah di-link ke akun lain "
            f"(*{already.get('email', '-')}*).\n\n"
            f"Kirim /unlink dulu, lalu /link lagi dengan token baru.",
            parse_mode="Markdown",
        )
        return

    # Update user record
    try:
        pb.update("users", target["id"], {
            "telegram_id": str(user.id),
            "telegram_username": user.username or "",
            "telegram_linked_at": datetime.now(timezone.utc).isoformat(),
            "telegram_link_token": "",
        })
    except Exception as e:
        log.exception("Gagal update user saat link")
        await msg.reply_text(f"❌ Gagal link akun: {e}")
        return

    log.info("✅ User %s linked to telegram %s", target["id"], user.id)

    kb = webapp_inline_keyboard()
    await msg.reply_text(
        f"✅ *Berhasil di-link!*\n\n"
        f"Akun Telegram Anda sudah tersambung dengan akun "
        f"`{target.get('email', '-')}`.\n\n"
        f"Anda akan menerima notifikasi pengingat otomatis.\n\n"
        f"Tap tombol di bawah untuk buka Mini App 👇",
        parse_mode="Markdown",
        reply_markup=kb,
    )


# ==================================================================== #
# /unlink
# ==================================================================== #
async def cmd_unlink(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    if not user:
        return

    vt = find_user_by_telegram_id(user.id)
    if not vt:
        await update.message.reply_text("⚠️ Akun ini belum ter-link.")
        return

    try:
        pb.update("users", vt["id"], {
            "telegram_id": "",
            "telegram_username": "",
            "telegram_linked_at": "",
            "telegram_link_token": "",
        })
    except Exception as e:
        await update.message.reply_text(f"❌ Gagal unlink: {e}")
        return

    await update.message.reply_text(
        "✅ Akun Telegram Anda sudah diputus dari Vehicle Tracker.\n\n"
        "Untuk link ulang, buka web app → *Pengaturan* → *Link Telegram*.",
        parse_mode="Markdown",
    )


# ==================================================================== #
# /status
# ==================================================================== #
async def cmd_status(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    if not user:
        return

    vt = find_user_by_telegram_id(user.id)
    if not vt:
        await update.message.reply_text(
            "⚠️ Akun belum ter-link.\n\n"
            "Buka web app → *Pengaturan* → *Link Telegram*.",
            parse_mode="Markdown",
        )
        return

    try:
        res = pb.list(
            "vehicles",
            filter=f'owner="{vt["id"]}"',
            sort="-created",
            perPage=20,
        )
    except Exception as e:
        await update.message.reply_text(f"❌ Error: {e}")
        return

    items = res.get("items", [])
    if not items:
        await update.message.reply_text("🚗 Belum ada kendaraan terdaftar.")
        return

    lines = [f"🚗 *Status Kendaraan — {vt.get('name', 'Anda')}*\n"]

    for v in items:
        jenis = v.get("jenis", "lainnya")
        icon = {"motor": "🏍️", "mobil": "🚗"}.get(jenis, "🚙")
        odo = int(v.get("odometer_terakhir") or 0)

        lines.append(
            f"{icon} *{v.get('nama', '-')}*\n"
            f"   Plat: `{v.get('plat_nomor', '-')}`\n"
            f"   Odometer: *{odo:,} km*\n".replace(",", ".")
        )

    kb = webapp_inline_keyboard()
    await update.message.reply_text(
        "\n".join(lines),
        parse_mode="Markdown",
        reply_markup=kb,
    )


# ==================================================================== #
# /reminders
# ==================================================================== #
async def cmd_reminders(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    if not user:
        return

    vt = find_user_by_telegram_id(user.id)
    if not vt:
        await update.message.reply_text(
            "⚠️ Akun belum ter-link. Buka web app → *Pengaturan* → *Link Telegram*.",
            parse_mode="Markdown",
        )
        return

    try:
        res = pb.list(
            "reminders",
            filter=f'owner="{vt["id"]}" && status="pending"',
            sort="created",
            perPage=50,
        )
        vehicles = pb.list(
            "vehicles",
            filter=f'owner="{vt["id"]}"',
            perPage=50,
        )
    except Exception as e:
        await update.message.reply_text(f"❌ Error: {e}")
        return

    vmap = {v["id"]: v for v in vehicles.get("items", [])}
    items = res.get("items", [])

    if not items:
        await update.message.reply_text("🎉 Tidak ada pengingat aktif.")
        return

    lines = ["🔔 *Daftar Pengingat Aktif*\n"]

    for r in items:
        v = vmap.get(r.get("vehicle"), {})
        vname = v.get("nama", "-")

        if r.get("tipe") == "km":
            target = int(r.get("target_km") or 0)
            current = int(v.get("odometer_terakhir") or 0)
            sisa = target - current

            if sisa < 0:
                status = f"🔴 LEWAT {abs(sisa):,} km".replace(",", ".")
            elif sisa == 0:
                status = "🔴 SEKARANG!"
            elif sisa <= 500:
                status = f"🟡 {sisa:,} km lagi".replace(",", ".")
            else:
                status = f"🔵 {sisa:,} km lagi".replace(",", ".")

            detail = f"target {target:,} km".replace(",", ".")
        else:
            d = days_until(r.get("target_date"))
            if d is None:
                status = "❔"
                detail = "-"
            elif d < 0:
                status = f"🔴 LEWAT {abs(d)} hari"
            elif d == 0:
                status = "🔴 HARI INI!"
            elif d <= 7:
                status = f"🟡 {d} hari lagi"
            else:
                status = f"🔵 {d} hari lagi"
            detail = fmt_date(r.get("target_date", ""))

        lines.append(
            f"{status}\n"
            f"  *{r.get('judul', '-')}* ({vname})\n"
            f"  {detail}\n"
        )

    kb = webapp_inline_keyboard()
    await update.message.reply_text(
        "\n".join(lines),
        parse_mode="Markdown",
        reply_markup=kb,
    )


# ==================================================================== #
# /ping
# ==================================================================== #
async def cmd_ping(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    start = time.time()
    msg = await update.message.reply_text("🏓 Pinging...")
    latency = (time.time() - start) * 1000
    await msg.edit_text(
        f"🏓 Pong!\n\n"
        f"⏱️ Latency: `{latency:.0f}ms`\n"
        f"🤖 Bot: @{BOT_USERNAME or 'unknown'}\n"
        f"🌐 PB: `{PB_URL}`",
        parse_mode="Markdown",
    )


# ==================================================================== #
# Daily Reminder Job — Jam 08:00 WIB
# ==================================================================== #
async def daily_reminder_job(ctx: ContextTypes.DEFAULT_TYPE):
    log.info("⏰ Running daily reminder job")

    try:
        users_res = pb.list("users", filter='telegram_id!=""', perPage=200)
    except Exception as e:
        log.error("daily job: gagal list users: %s", e)
        return

    users = users_res.get("items", [])
    log.info("Daily job: %d user(s) with Telegram linked", len(users))

    for user in users:
        try:
            await _notify_user(user, ctx)
        except Exception as e:
            log.exception("Daily job: error untuk user %s", user.get("id"))


async def _notify_user(user, ctx: ContextTypes.DEFAULT_TYPE):
    uid = user["id"]
    tg_id = user.get("telegram_id")
    if not tg_id:
        return

    try:
        # Ambil vehicles & reminders
        vehicles = pb.list("vehicles", filter=f'owner="{uid}"', perPage=50)
        vmap = {v["id"]: v for v in vehicles.get("items", [])}

        reminders = pb.list(
            "reminders",
            filter=f'owner="{uid}" && status="pending"',
            perPage=100,
        )
    except Exception as e:
        log.error("Failed fetch data for %s: %s", uid, e)
        return

    if not reminders.get("items"):
        return

    # Kumpulkan yang due/overdue
    alerts = []
    for r in reminders["items"]:
        v = vmap.get(r.get("vehicle"))
        if not v:
            continue

        if r.get("tipe") == "km":
            sisa = int(r.get("target_km") or 0) - int(v.get("odometer_terakhir") or 0)
            if sisa <= 500:
                label = "🔴 LEWAT" if sisa < 0 else "🟡 SEGERA"
                alerts.append(
                    (r, v, f"{label}: {abs(sisa):,} km".replace(",", "."))
                )
        else:
            d = days_until(r.get("target_date"))
            if d is not None and d <= 7:
                label = "🔴 LEWAT" if d < 0 else "🟡 SEGERA"
                alerts.append(
                    (r, v, f"{label}: {abs(d)} hari")
                )

    if not alerts:
        return

    lines = [f"🔔 *Pengingat Hari Ini — {user.get('name', 'Anda')}*\n"]

    for r, v, status in alerts:
        lines.append(
            f"• *{r.get('judul', '-')}* ({v.get('nama', '-')})\n"
            f"  {status}"
        )

    lines.append("\nKirim /reminders untuk detail lengkap.")

    try:
        await ctx.bot.send_message(
            chat_id=int(tg_id),
            text="\n".join(lines),
            parse_mode="Markdown",
        )
        log.info("✅ Notif terkirim ke %s", tg_id)
    except Exception as e:
        log.warning("Gagal kirim ke %s: %s", tg_id, e)


# ==================================================================== #
# Fallback handler — pesan teks tanpa command
# ==================================================================== #
async def handle_unknown(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    """Reply untuk pesan teks biasa (bukan command)."""
    if not update.message:
        return

    kb = webapp_inline_keyboard()
    await update.message.reply_text(
        "🤖 Maaf, saya tidak mengerti pesan itu.\n\n"
        "Coba command:\n"
        "• /status — status kendaraan\n"
        "• /reminders — pengingat aktif\n"
        "• /help — bantuan lengkap\n\n"
        "Atau tap tombol di bawah untuk buka Mini App 👇",
        parse_mode="Markdown",
        reply_markup=kb,
    )


# ==================================================================== #
# Error handler
# ==================================================================== #
async def error_handler(update: object, ctx: ContextTypes.DEFAULT_TYPE):
    log.error("Exception while handling update:", exc_info=ctx.error)

    # Notifikasi user (kalau bisa)
    if isinstance(update, Update) and update.effective_message:
        try:
            await update.effective_message.reply_text(
                "⚠️ Terjadi kesalahan internal. Coba lagi nanti atau "
                "hubungi admin."
            )
        except Exception:
            pass


# ==================================================================== #
# Main
# ==================================================================== #
def main():
    log.info("🚀 Starting bot @%s", BOT_USERNAME or "(unknown)")
    log.info("🌐 PocketBase: %s", PB_URL)
    log.info("📱 WebApp URL: %s", WEBAPP_URL or "(not set)")

    app = (
        Application.builder()
        .token(BOT_TOKEN)
        .post_init(post_init)
        .build()
    )

    # Command handlers
    app.add_handler(CommandHandler("start", cmd_start))
    app.add_handler(CommandHandler("help", cmd_help))
    app.add_handler(CommandHandler("link", cmd_link))
    app.add_handler(CommandHandler("unlink", cmd_unlink))
    app.add_handler(CommandHandler("status", cmd_status))
    app.add_handler(CommandHandler("reminders", cmd_reminders))
    app.add_handler(CommandHandler("ping", cmd_ping))

    # Fallback text handler (paling akhir)
    app.add_handler(MessageHandler(
        filters.TEXT & ~filters.COMMAND,
        handle_unknown,
    ))

    # Error handler
    app.add_error_handler(error_handler)

    # Daily job — setiap hari jam 08:00 WIB
    if app.job_queue:
        app.job_queue.run_daily(
            daily_reminder_job,
            time=dt_time(hour=DAILY_HOUR_WIB, minute=0, tzinfo=WIB),
            name="daily_reminder",
        )
        log.info("⏰ Daily job dijadwalkan jam %02d:00 WIB", DAILY_HOUR_WIB)
    else:
        log.warning("⚠️  JobQueue tidak tersedia. "
                    "Install python-telegram-bot[job-queue] untuk daily reminder.")

    log.info("🤖 Bot polling... (Ctrl+C untuk stop)")

    app.run_polling(
        allowed_updates=Update.ALL_TYPES,
        drop_pending_updates=True,
    )


# ==================================================================== #
if __name__ == "__main__":
    main()