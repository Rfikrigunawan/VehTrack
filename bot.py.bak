#!/usr/bin/env python3
"""
Vehicle Tracker — Telegram Bot
================================
Fitur:
  - Link akun via /link <token>
  - Quick view /status, /reminders
  - Daily reminder cron jam 08:00 WIB
  - Mini App (WebApp) menu button + inline button
  - Command /unlink, /help, /ping

Jalankan:
    python bot.py
"""

import os
import time
import logging
from datetime import datetime, time as dt_time, timezone, timedelta

import requests
from dotenv import load_dotenv
from telegram import (
    Update,
    InlineKeyboardButton,
    InlineKeyboardMarkup,
    MenuButtonWebApp,
    WebAppInfo,
    BotCommand,
)
from telegram.ext import (
    Application,
    CommandHandler,
    ContextTypes,
    MessageHandler,
    filters,
)

# ==================================================================== #
# Config & Env
# ==================================================================== #
import logging.handlers
from pathlib import Path

load_dotenv()

# ---------- Logging: Console + File (rotating) ---------- #
LOG_DIR = Path(__file__).parent / "logs"
LOG_DIR.mkdir(exist_ok=True)

LOG_FORMAT = "%(asctime)s [%(levelname)s] %(name)s: %(message)s"
LOG_DATE_FMT = "%Y-%m-%d %H:%M:%S"

# Root logger
root_logger = logging.getLogger()
root_logger.setLevel(logging.INFO)

# Hapus handler lama
for h in root_logger.handlers[:]:
    root_logger.removeHandler(h)

# Formatter
formatter = logging.Formatter(LOG_FORMAT, datefmt=LOG_DATE_FMT)

# Handler 1: Console
console_handler = logging.StreamHandler()
console_handler.setFormatter(formatter)
console_handler.setLevel(logging.INFO)
root_logger.addHandler(console_handler)

# Handler 2: File rotasi — bot.log
file_handler = logging.handlers.RotatingFileHandler(
    LOG_DIR / "bot.log",
    maxBytes=5 * 1024 * 1024,   # 5 MB
    backupCount=5,
    encoding="utf-8",
)
file_handler.setFormatter(formatter)
file_handler.setLevel(logging.INFO)
root_logger.addHandler(file_handler)

# Kurangi noise dari library eksternal (httpx, telegram, dll)
logging.getLogger("httpx").setLevel(logging.WARNING)
logging.getLogger("httpcore").setLevel(logging.WARNING)
logging.getLogger("telegram.ext.Application").setLevel(logging.INFO)
logging.getLogger("telegram.Bot").setLevel(logging.INFO)
logging.getLogger("urllib3").setLevel(logging.WARNING)

# Logger untuk modul ini
log = logging.getLogger("vt-bot")

PB_URL = os.getenv("PB_URL", "https://acer-pb.gwan.my.id").rstrip("/")
PB_ADMIN_EMAIL = os.getenv("PB_ADMIN_EMAIL", "")
PB_ADMIN_PASSWORD = os.getenv("PB_ADMIN_PASSWORD", "")

BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN", "")
BOT_USERNAME = os.getenv("TELEGRAM_BOT_USERNAME", "").lstrip("@")
WEBAPP_URL = os.getenv("WEBAPP_URL", "").rstrip("/")

TOKEN_MAX_AGE_SEC = 5 * 60            # Link token valid 5 menit
WIB = timezone(timedelta(hours=7))    # GMT+7
DAILY_HOUR_WIB = 8                    # Jam 8 pagi WIB


# ==================================================================== #
# Validasi env
# ==================================================================== #
if not BOT_TOKEN:
    raise SystemExit("❌ TELEGRAM_BOT_TOKEN belum di-set di .env")

if not PB_ADMIN_EMAIL or not PB_ADMIN_PASSWORD:
    raise SystemExit("❌ PB_ADMIN_EMAIL / PB_ADMIN_PASSWORD belum di-set di .env")

if not WEBAPP_URL:
    log.warning("⚠️  WEBAPP_URL belum di-set — Mini App menu button tidak akan muncul")


# ==================================================================== #
# PocketBase Admin Client
# ==================================================================== #
class AdminPB:
    """Client PocketBase dengan superuser token."""

    def __init__(self, url: str, email: str, password: str):
        self.url = url.rstrip("/")
        self.email = email
        self.password = password
        self.token = None
        self._login()

    def _login(self):
        try:
            r = requests.post(
                f"{self.url}/api/collections/_superusers/auth-with-password",
                json={"identity": self.email, "password": self.password},
                timeout=20,
            )
            r.raise_for_status()
            self.token = r.json()["token"]
            log.info("✅ Admin PB login OK")
        except requests.RequestException as e:
            log.error("❌ Admin PB login gagal: %s", e)
            raise

    def _headers(self) -> dict:
        return {"Authorization": f"Bearer {self.token}"}

    def _request(self, method: str, path: str, **kwargs):
        url = f"{self.url}{path}"
        for attempt in range(3):
            try:
                r = requests.request(
                    method, url,
                    headers=self._headers(),
                    timeout=(10, 30),
                    **kwargs,
                )
                if r.status_code == 401:
                    log.warning("Token expired, re-login...")
                    self._login()
                    continue
                r.raise_for_status()
                return r.json() if r.content else None
            except requests.RequestException as e:
                if attempt < 2:
                    time.sleep(1.5 * (attempt + 1))
                    continue
                log.error("Request error after retries: %s", e)
                raise

    def list(self, collection: str, **params):
        return self._request("GET", f"/api/collections/{collection}/records", params=params)

    def get(self, collection: str, rid: str):
        return self._request("GET", f"/api/collections/{collection}/records/{rid}")

    def update(self, collection: str, rid: str, data: dict):
        return self._request("PATCH", f"/api/collections/{collection}/records/{rid}", json=data)


pb = AdminPB(PB_URL, PB_ADMIN_EMAIL, PB_ADMIN_PASSWORD)


# ==================================================================== #
# Helpers
# ==================================================================== #
def is_token_fresh(token: str, max_age_sec: int = TOKEN_MAX_AGE_SEC) -> bool:
    """Cek token masih fresh (berdasarkan unix timestamp di awal token)."""
    try:
        ts_str, _ = token.split(".", 1)
        return (time.time() - int(ts_str)) < max_age_sec
    except (ValueError, AttributeError):
        return False


def find_user_by_link_token(token: str):
    """Cari user dengan telegram_link_token = token."""
    try:
        res = pb.list("users", filter=f'telegram_link_token="{token}"', perPage=1)
        items = res.get("items", [])
        return items[0] if items else None
    except Exception as e:
        log.error("find_user_by_link_token error: %s", e)
        return None


def find_user_by_telegram_id(tg_id: int):
    """Cari user dengan telegram_id = tg_id."""
    try:
        res = pb.list("users", filter=f'telegram_id="{tg_id}"', perPage=1)
        items = res.get("items", [])
        return items[0] if items else None
    except Exception as e:
        log.error("find_user_by_telegram_id error: %s", e)
        return None


def fmt_date(date_str: str) -> str:
    """Format tanggal ISO ke format Indonesia singkat."""
    if not date_str:
        return "-"
    try:
        # Handle format "2026-09-22 00:00:00.000Z" atau "2026-09-22"
        s = date_str.replace("Z", "+00:00")
        if "." in s and "+" not in s:
            s = s.split(".")[0]
        d = datetime.fromisoformat(s.replace(" ", "T"))
        # Convert ke WIB
        if d.tzinfo is None:
            d = d.replace(tzinfo=timezone.utc)
        d_wib = d.astimezone(WIB)
        bulan = ["Jan", "Feb", "Mar", "Apr", "Mei", "Jun",
                 "Jul", "Ags", "Sep", "Okt", "Nov", "Des"]
        return f"{d_wib.day} {bulan[d_wib.month - 1]} {d_wib.year}"
    except (ValueError, AttributeError):
        return date_str[:10] if date_str else "-"


def days_until(date_str: str):
    """Hitung selisih hari dari hari ini (WIB) ke target date."""
    if not date_str:
        return None
    try:
        s = date_str.replace("Z", "+00:00")
        if "." in s and "+" not in s:
            s = s.split(".")[0]
        d = datetime.fromisoformat(s.replace(" ", "T"))
        if d.tzinfo is None:
            d = d.replace(tzinfo=timezone.utc)
        d_wib = d.astimezone(WIB).date()
        now_wib = datetime.now(WIB).date()
        return (d_wib - now_wib).days
    except (ValueError, AttributeError):
        return None


# ==================================================================== #
# Bot lifecycle — Set menu button & commands
# ==================================================================== #
async def post_init(application: Application):
    """Dipanggil setelah bot start. Set menu button & command list."""

    # 1. Set command list
    try:
        await application.bot.set_my_commands([
            BotCommand("start", "Sapaan & menu"),
            BotCommand("status", "Status kendaraan"),
            BotCommand("reminders", "Daftar pengingat aktif"),
            BotCommand("link", "Link akun (dengan token)"),
            BotCommand("unlink", "Putuskan tautan Telegram"),
            BotCommand("help", "Bantuan"),
        ])
        log.info("✅ Commands list di-set")
    except Exception as e:
        log.error("Gagal set commands: %s", e)

    # 2. Set menu button (Mini App)
    if WEBAPP_URL:
        try:
            await application.bot.set_chat_menu_button(
                menu_button=MenuButtonWebApp(
                    text="Buka App",
                    web_app=WebAppInfo(url=WEBAPP_URL),
                )
            )
            log.info("✅ Menu button Mini App di-set → %s", WEBAPP_URL)
        except Exception as e:
            log.error("Gagal set menu button: %s", e)
    else:
        log.warning("⚠️  WEBAPP_URL kosong — menu button tidak di-set")


# ==================================================================== #
# Helper — Keyboard builders
# ==================================================================== #
def webapp_inline_keyboard() -> InlineKeyboardMarkup | None:
    """Inline keyboard dengan tombol Mini App."""
    if not WEBAPP_URL:
        return None
    return InlineKeyboardMarkup([[
        InlineKeyboardButton(
            "🚗 Buka Vehicle Tracker",
            web_app=WebAppInfo(url=WEBAPP_URL),
        )
    ]])


# ==================================================================== #
# /start
# ==================================================================== #
async def cmd_start(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    msg = update.effective_message
    user = update.effective_user
    if not msg or not user:
        return

    existing = find_user_by_telegram_id(user.id)
    kb = webapp_inline_keyboard()

    if existing:
        text = (
            f"👋 Halo *{existing.get('name', 'user')}*!\n\n"
            f"Akun Telegram Anda sudah ter-link dengan Vehicle Tracker.\n\n"
            f"*Akses Cepat:*\n"
            f"• Tap tombol di bawah untuk buka Mini App\n"
            f"• /status — status semua kendaraan\n"
            f"• /reminders — daftar pengingat aktif\n"
            f"• /unlink — putuskan tautan\n"
            f"• /help — bantuan"
        )
    else:
        text = (
            "🚗 *Vehicle Tracker Bot*\n\n"
            "Bot ini terhubung dengan aplikasi *Vehicle Tracker* "
            "untuk manajemen kendaraan Anda.\n\n"
            "*Cara Link Akun:*\n"
            "1. Buka web app Vehicle Tracker\n"
            "2. Login → Pengaturan → Link Telegram\n"
            "3. Copy token yang muncul\n"
            "4. Kirim ke bot ini:\n"
            "   `/link <token>`\n\n"
            "Setelah ter-link, Anda bisa buka Mini App dari tombol di bawah 👇"
        )

    await msg.reply_text(text, parse_mode="Markdown", reply_markup=kb)


